{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "expo-auth-session/build/QueryParams": [
        "./node_modules/expo-auth-session/build/QueryParams.d.ts"
      ]
    },
    "types": [
      "jest"
    ],
    "ignoreDeprecations": "6.0"
  },
